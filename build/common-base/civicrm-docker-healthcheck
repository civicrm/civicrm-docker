#!/usr/bin/env php
<?php
// This healthcheck parses Civi's System.check entity. Each element is counted, aggregated by its severity level and passed to stdout.
// stdout of the healthcheck is written to a container's Health.Log.Output object.
// A threshold 'HEALTHCHECK_SENSITIVITY' (default is 3) is defined and if an element with a higher severity score than the threshold is present, 
// the container reports as unhealthy (exit code 1). Otherwise it reports as healthy. The HEALTHCHECK_SENSITIVITY can be set as an env variable.

// This code is entirely created by an LLM. Please add your name if you looked at this and think it's fine
declare(strict_types=1);

const DEFAULT_SENSITIVITY = 3;

// APIv4 only returns severity_id, so map it to the PSR-3 level names
const SEVERITY_NAMES = [
    0 => 'debug', 1 => 'info', 2 => 'notice', 3 => 'warning',
    4 => 'error', 5 => 'critical', 6 => 'alert', 7 => 'emergency',
];

function fail(string $msg): never
{
    fwrite(STDERR, "healthcheck: $msg\n");
    exit(1);
}

// Sensitivity: unset/empty -> default, invalid -> warn and fall back
$raw = getenv('HEALTHCHECK_SENSITIVITY');
if ($raw === false || $raw === '') {
    $sens = DEFAULT_SENSITIVITY;
} elseif (preg_match('/^[0-7]$/', $raw)) {
    $sens = (int)$raw;
} else {
    fwrite(STDERR, "healthcheck: HEALTHCHECK_SENSITIVITY must be between 0-7 (got: '$raw'), falling back to " . DEFAULT_SENSITIVITY . "\n");
    $sens = DEFAULT_SENSITIVITY;
}

// Run cv (equivalent of `set -e`): non-zero exit -> unhealthy. stderr is passed through.
$proc = proc_open(
    ['cv', 'api4', 'System.check', '--out=json-strict'],
    [1 => ['pipe', 'w'], 2 => STDERR],
    $pipes
);
if (!is_resource($proc)) {
    fail('could not start cv');
}
$out = stream_get_contents($pipes[1]);
fclose($pipes[1]);
$code = proc_close($proc);
if ($code !== 0) {
    fail("cv exited with code $code");
}

// Parse response: APIv4 returns a plain list of checks; an error object is not a list
$checks = json_decode((string)$out, true);
if (!is_array($checks) || !array_is_list($checks)) {
    fail('invalid cv response');
}

$count = $over = [];
foreach ($checks as $c) {
    if (!is_array($c) || !isset($c['severity_id'])) {
        continue;
    }
    if (!($c['is_visible'] ?? true)) {
        continue; // ignore snoozed checks
    }
    $id = (int)$c['severity_id'];
    $count[$id] = ($count[$id] ?? 0) + 1;   // count occurrences of each severity
    if ($id > $sens) {
        $over[] = "  - {$c['name']} (" . (SEVERITY_NAMES[$id] ?? $id) . ')';
    }
}
krsort($count); // critical levels first

$parts = [];
foreach ($count as $id => $n) {
    $parts[] = (SEVERITY_NAMES[$id] ?? (string)$id) . "=$n";
}
$summary = $parts ? implode(' ', $parts) : 'no checks';

if ($over) {
    echo "unhealthy: $summary | " . implode(" | ", $over);
    exit(1);
}
echo "healthy: $summary\n";