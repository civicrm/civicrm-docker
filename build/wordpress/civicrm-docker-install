#!/usr/bin/env php
<?php

/**
 * Install WordPress and CiviCRM using the database and site settings passed
 * in as environment variables.
 */

require_once '/usr/local/lib/civicrm-docker/install-functions.php';

// Check this before WordPress is installed, so a missing variable can't leave
// a half-installed site.
$dsn = getDsn();
$url = requireEnv('CIVICRM_UF_BASEURL');
$configFile = requireEnv('WORDPRESS_CONFIG_FILE');

run([
  'wp', 'config', 'create',
  '--dbhost=' . getenv('WORDPRESS_DB_HOST'),
  '--dbname=' . getenv('WORDPRESS_DB_NAME'),
  '--dbuser=' . getenv('WORDPRESS_DB_USER'),
  '--dbpass=' . getenv('WORDPRESS_DB_PASSWORD'),
  '--config-file=' . $configFile,
]);

// The wrapper wp-config.php in the web root loads ABSPATH and wp-settings.php
// itself, so drop everything from this marker onwards.
$config = file_get_contents($configFile);
$marker = strpos($config, "/* That's all, stop editing! Happy publishing. */");
if ($marker !== FALSE) {
  $lineStart = strrpos(substr($config, 0, $marker), "\n");
  file_put_contents($configFile, substr($config, 0, $lineStart === FALSE ? 0 : $lineStart + 1));
}

run([
  'wp', 'core', 'install',
  '--url=' . $url,
  '--title=' . getenv('WORDPRESS_SITE_TITLE'),
  '--admin_user=' . getenv('CIVICRM_ADMIN_USER'),
  '--admin_password=' . getenv('CIVICRM_ADMIN_PASS'),
  '--admin_email=' . getenv('CIVICRM_ADMIN_EMAIL'),
]);

run(['wp', 'option', 'update', 'timezone_string', 'UTC']);
run(['wp', 'rewrite', 'structure', '/%postname%/', '--hard']);

run([
  'cv', 'core:install',
  '--db=' . $dsn,
  '--url=' . $url,
  '-m', 'extras.adminUser=' . getenv('CIVICRM_ADMIN_USER'),
  '-m', 'extras.adminPass=' . getenv('CIVICRM_ADMIN_PASS'),
]);
