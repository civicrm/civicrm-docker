#!/usr/bin/env bash
set -ex

# create wp-config.php file
wp config create --dbhost="${WORDPRESS_DB_HOST}" --dbname="${WORDPRESS_DB_NAME}" --dbuser="${WORDPRESS_DB_USER}" --dbpass="${WORDPRESS_DB_PASSWORD}" --config-file="${WORDPRESS_CONFIG_FILE}"

# Remove the ending lines from the external config file
# The wrapper file (build/wordpress/wp-config.php) handles ABSPATH and wp-settings.php instead
sed -i "/\/\* That's all, stop editing! Happy publishing\. \*\//,\$d" "${WORDPRESS_CONFIG_FILE}"

# WordPress names some locales by language only (ja, not ja_JP): unless WORDPRESS_LANG is set, try that too.
if [ -n "${WORDPRESS_LANG:-}" ]; then
  export WORDPRESS_LANGS="${WORDPRESS_LANG}"
elif [ -n "${CIVICRM_LANG:-}" ]; then
  export WORDPRESS_LANGS="${CIVICRM_LANG} ${CIVICRM_LANG%%_*}"
fi

# Download first, like wp-admin/install.php, so that a failed download stops before WordPress is installed.
# en_US is built in and has no language pack.
if [ -n "${WORDPRESS_LANGS:-}" ] && [ "${WORDPRESS_LANGS%% *}" != en_US ]; then
  WORDPRESS_LANG="$(wp --exec='define("WP_INSTALLING", true);' eval-file - <<'PHP'
<?php
require_once ABSPATH . 'wp-admin/includes/translation-install.php';
foreach (explode(' ', getenv('WORDPRESS_LANGS')) as $lang) {
  if (wp_download_language_pack($lang)) {
    echo $lang;
    return;
  }
}
WP_CLI::error('Could not download a WordPress language pack for ' . getenv('WORDPRESS_LANGS')
  . '. Set WORDPRESS_LANG to the locale WordPress uses.');
PHP
  )"
fi

wp core install \
  --url="${CIVICRM_UF_BASEURL}" --title="${WORDPRESS_SITE_TITLE}" \
  --admin_user="${CIVICRM_ADMIN_USER}" --admin_password="${CIVICRM_ADMIN_PASS}" \
  --admin_email="${CIVICRM_ADMIN_EMAIL}" ${WORDPRESS_LANG:+--locale="${WORDPRESS_LANG}"}

# Correct default timezone and set default permalink
wp option update timezone_string "UTC"
wp rewrite structure '/%postname%/' --hard

cv core:install \
  --db="mysql://${CIVICRM_DB_USER}:${CIVICRM_DB_PASSWORD}@${CIVICRM_DB_HOST}:${CIVICRM_DB_PORT}/${CIVICRM_DB_NAME}" \
  --url="${CIVICRM_UF_BASEURL}" \
  ${CIVICRM_LANG:+--lang="${CIVICRM_LANG}"} \
  -m "extras.adminUser=${CIVICRM_ADMIN_USER}" \
  -m "extras.adminPass=${CIVICRM_ADMIN_PASS}"
